# ============================================================
# .env.production.example
# Copy file ini ke .env di VPS: cp .env.production.example .env
# Lalu isi semua value yang masih placeholder
# ============================================================

# ── Database (self-hosted PostgreSQL di Docker) ──
POSTGRES_USER=blockmaps
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
POSTGRES_DB=blockmaps

# Prisma — otomatis di-compose lewat env, tapi tetap perlu di .env
# untuk entrypoint.sh (prisma migrate deploy)
DATABASE_URL=postgresql://blockmaps:GANTI_PASSWORD_KUAT_DISINI@db:5432/blockmaps
DIRECT_URL=postgresql://blockmaps:GANTI_PASSWORD_KUAT_DISINI@db:5432/blockmaps

# ── Auth ──
AUTH_SECRET=GENERATE_RANDOM_STRING_32_CHAR
NEXTAUTH_URL=https://yourdomain.com
BASE_URL=https://yourdomain.com

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Cloudinary ──
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Midtrans ──
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_ENV=production

# ── SMTP (Email) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Docker Image ──
DOCKER_IMAGE=your-dockerhub-username/blockmaps-saas:latest

# ── Migration flag (set true saat pertama kali / ada schema change) ──
RUN_MIGRATIONS=true
